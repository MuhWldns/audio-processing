# ============================================
# RBX Royale Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.

# Server
NODE_ENV=development
PORT=3001

# Frontend URL (for CORS and OAuth redirects)
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database (MySQL via Prisma)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/audio_processing"

# Session
SESSION_SECRET="replace-with-a-long-random-string"

# Upload
UPLOAD_API_KEY=
UPLOAD_RATE_LIMIT=30
UPLOAD_RATE_WINDOW_MIN=15

# OAuth — Google
# Set redirect URL in Google Developer Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# OAuth — Discord
# Set redirect URL in Discord Developer Portal
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3001/auth/discord/callback

# Payment Gateway — Bayar.gg (QRIS)
BAYARGG_API_KEY=
BAYARGG_BASE_URL=https://www.bayar.gg/api
BAYARGG_WEBHOOK_SECRET=
BAYARGG_WEBHOOK_URL=

# Payment provider selector: "bayar.gg" (webhook) or "mustika" (polling)
TOPUP_PROVIDER=bayar.gg

# Payment Gateway — MustikaPay (QRIS, polling-based, no webhook secret)
MUSTIKAPAY_API_KEY=
MUSTIKAPAY_BASE_URL=https://mustikapayment.com
